# Copia este archivo como .env y completa los valores.

# PostgreSQL (Neon). En Vercel: Settings → Environment Variables.
DATABASE_URL="postgresql://usuario:clave@host/db?sslmode=require"

# Secreto para firmar sesiones (obligatorio en producción). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""

# URL pública de la app. En Vercel se deduce sola; en local:
BETTER_AUTH_URL="http://localhost:3000"

# Correo del dueño: al crear su empresa, adopta las cotizaciones creadas antes del inicio de sesión.
COTIZALO_OWNER_EMAIL=""

# "true" para cerrar el registro de nuevas cuentas (solo ingresan las existentes).
DISABLE_SIGNUP="false"
